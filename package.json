{
  "name": "mushy-harness",
  "private": true,
  "type": "module",
  "description": "The Mushy build loop: scheduler, agent adapters, gate and merge queue.",
  "engines": { "node": ">=26" },
  "bin": { "helix-loop": "./bin/helix-loop.ts", "mushy-loop": "./bin/mushy-loop.ts" },
  "scripts": {
